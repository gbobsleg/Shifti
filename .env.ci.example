# =============================================================================
# Variables d'environnement — CI GitHub Actions (secrets factices)
# Copié tel quel en .env par le job build-and-smoke.
# Ne pas utiliser en production.
# =============================================================================

# --- Application CakePHP ---
DEBUG=false
APP_NAME=Shifti
APP_ENCODING=UTF-8
APP_DEFAULT_LOCALE=fr_FR
APP_DEFAULT_TIMEZONE=Europe/Paris

SECURITY_SALT=ci_salt_not_for_production_use_only_testing_32chars

APP_HTTP_PORT=8080
# Préfixe projet Compose ; isolé du stack local via docker-compose.ci.yml (conteneurs shifti_ci_*)
COMPOSE_PROJECT_NAME=shifti_ci

# --- MariaDB (service Docker `db`) ---
MYSQL_ROOT_PASSWORD=ci_root_password_not_for_production
MYSQL_DATABASE=cake_planning
MYSQL_USER=planning
MYSQL_PASSWORD=ci_planning_password_not_for_production

# --- Liaison CakePHP → MariaDB ---
DATABASE_URL=mysql://planning:ci_planning_password_not_for_production@db:3306/cake_planning?encoding=utf8mb4&timezone=UTC&cacheMetadata=true&quoteIdentifiers=false&persistent=false

# --- Prophet (forecast_prophet.py) ---
DB_HOST=db
DB_USER=planning
DB_PASSWORD=ci_planning_password_not_for_production
DB_NAME=cake_planning

# =============================================================================
# Variables d'environnement — déploiement Docker (production)
# Copier vers .env (fichier lu par docker compose) puis adapter les secrets :
#   cp .env.docker.example .env
# =============================================================================

# --- Application CakePHP ---
DEBUG=false
APP_NAME=Shifti
APP_ENCODING=UTF-8
APP_DEFAULT_LOCALE=fr_FR
APP_DEFAULT_TIMEZONE=Europe/Paris

# Obligatoire : générer une chaîne aléatoire longue (ex. openssl rand -hex 32)
SECURITY_SALT=REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_LONGUE

# Port HTTP publié sur l'hôte
APP_HTTP_PORT=8080

# --- MariaDB (service Docker `db`) ---
MYSQL_ROOT_PASSWORD=change_me_root_TRES_FORT
MYSQL_DATABASE=cake_planning
MYSQL_USER=planning
MYSQL_PASSWORD=change_me_planning_TRES_FORT

# --- Liaison CakePHP → MariaDB (host Docker = nom du service) ---
# Note : docker-compose.yml reconstruit aussi DATABASE_URL ; cette ligne
# sert de référence / usage hors Compose.
DATABASE_URL=mysql://planning:change_me_planning_TRES_FORT@db:3306/cake_planning?encoding=utf8mb4&timezone=UTC&cacheMetadata=true&quoteIdentifiers=false&persistent=false

# --- Prophet (forecast_prophet.py) : mêmes credentials que MYSQL_* ---
DB_HOST=db
DB_USER=planning
DB_PASSWORD=change_me_planning_TRES_FORT
DB_NAME=cake_planning
